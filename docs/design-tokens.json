{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "project": "BoatBuddy",
    "description": "Nautical-themed design tokens for a shared boat management app",
    "framework": "Tailwind CSS v4 + shadcn/ui",
    "source": "src/index.css @theme block"
  },
  "color": {
    "light": {
      "background": "#F8FAFB",
      "foreground": "#0C1B33",
      "muted": "#EEF3F7",
      "muted-foreground": "#4A6080",
      "border": "#C8D9E6",
      "input": "#C8D9E6",
      "ring": "#0077B6",
      "primary": "#0C1B33",
      "primary-foreground": "#FFFFFF",
      "secondary": "#EEF3F7",
      "secondary-foreground": "#0C1B33",
      "accent": "#0077B6",
      "accent-foreground": "#FFFFFF",
      "destructive": "#D93F3F",
      "destructive-foreground": "#FFFFFF",
      "card": "#FFFFFF",
      "card-foreground": "#0C1B33",
      "popover": "#FFFFFF",
      "popover-foreground": "#0C1B33",
      "success": "#2D9E6B",
      "success-foreground": "#FFFFFF",
      "warning": "#E09B3D",
      "warning-foreground": "#FFFFFF"
    },
    "dark": {
      "background": "#0A1628",
      "foreground": "#E8F0F7",
      "muted": "#112340",
      "muted-foreground": "#8AAEC6",
      "border": "#1E3A55",
      "input": "#1E3A55",
      "ring": "#38B6E8",
      "primary": "#E8F0F7",
      "primary-foreground": "#0A1628",
      "secondary": "#112340",
      "secondary-foreground": "#E8F0F7",
      "accent": "#38B6E8",
      "accent-foreground": "#0A1628",
      "destructive": "#F87171",
      "destructive-foreground": "#0A1628",
      "card": "#0F1F38",
      "card-foreground": "#E8F0F7",
      "popover": "#0F1F38",
      "popover-foreground": "#E8F0F7",
      "success": "#4ADE80",
      "success-foreground": "#0A1628",
      "warning": "#FBBF24",
      "warning-foreground": "#0A1628"
    },
    "person": {
      "roger": { "light": "#0D9488", "dark": "#2DD4BF" },
      "dani": { "light": "#F59E0B", "dark": "#FBBF24" },
      "pedro": { "light": "#9CA3AF", "dark": "#6B7280" }
    }
  },
  "radius": {
    "sm": "0.25rem",
    "default": "0.5rem",
    "md": "0.75rem",
    "lg": "1rem"
  },
  "font": {
    "sans": "\"Inter\", ui-sans-serif, system-ui, sans-serif"
  },
  "animation": {
    "card-hover-lift": "translateY(-2px)",
    "slide-up-duration": "0.5s",
    "stagger-delay": "60ms",
    "shimmer-duration": "2s",
    "today-pulse-duration": "2.5s"
  },
  "categories": [
    "bootskauf", "bootsplatz", "versicherung", "verkehrssteuer",
    "winterlager", "fruehlingslager", "vorfuehren", "treibstoff",
    "material", "reparatur", "service", "sonstiges"
  ],
  "activities": ["wakesurfen", "wakeboarden", "cruisen", "sonstiges"]
}
